# Copy this file to .env and update the database password and secret.
# URL-encode reserved password characters; for example, @ must be written as %40.
# Example MySQL: mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/interviewace
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/interviewace
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen2.5:1.5b
EMBED_MODEL=nomic-embed-text
DOCKER_CONFIG=./data/docker-cli
HF_HOME=./data/huggingface
RUNNER_IMAGE=interviewace-runner:local
WHISPER_MODEL=tiny.en
# Cookie sessions: Secure must be true for an HTTPS deployment.
COOKIE_SECURE=false
SESSION_HOURS=8
SESSION_IDLE_MINUTES=30
TRUSTED_HOSTS=127.0.0.1,localhost,testserver
# PUBLIC_ORIGIN=https://your-domain.example
# Disable public code execution unless a separately reviewed isolated runner is provisioned.
ENABLE_CODE_EXECUTION=true
# Only needed for the optional compose.yaml MySQL service (port 3307).
MYSQL_PASSWORD=CHANGE_THIS_LOCAL_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_THIS_LOCAL_ROOT_PASSWORD
